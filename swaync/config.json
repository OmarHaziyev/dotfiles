{
  "positionX": "left",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "fit-to-screen": true,
  "control-center-layer": "top",

  "control-center-width": 380,
  "control-center-height": 650,
  "control-center-margin-top": 24,
  "control-center-margin-left": 12,
  "control-center-margin-bottom": 24,

  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,

  "widgets": [
    "mpris",
    "dnd",
    "title",
    "notifications",
    "volume",
    "backlight"
  ],

  "widget-config": {

    "mpris": {
      "image-size": 90,
      "image-radius": 14,
      "autohide": true,
      "show-album": true,
      "show-tracks": true
    },

    "dnd": { "text": "Do Not Disturb" },
    "title": { "text": "Notifications", "clear-all-button": true, "button-text": "󰆴" },
    "notifications": { "vexpand": false },
    "volume": { "label": "󰕾", "show-per-app": false },
    "backlight": { "label": "󰃟", "device": "intel_backlight", "subsystem": "backlight", "min": 10 }
  }
}