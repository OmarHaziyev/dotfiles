/*
 * colors.rasi generated by matugen from the current wallpaper.
 * Mirrors ~/.config/theme/colors.css using the same name-to-role mapping,
 * with the alpha values the original static palette used baked back in
 * (rofi can't read GTK's alpha()/@define-color, so it needs literal RGBA
 * hex). Do not hand-edit edit this template instead.
 */

* {
    base:       #{{colors.surface.default.hex_stripped}}FF;
    mantle:     #{{colors.surface_container_lowest.default.hex_stripped}}FF;
    surface0:   #{{colors.surface_container.default.hex_stripped}}E6;
    surface1:   #{{colors.surface_container_high.default.hex_stripped}}E6;
    overlay:    #{{colors.outline.default.hex_stripped}}80;

    text:       #{{colors.on_surface.default.hex_stripped}}FF;
    subtext:    #{{colors.on_surface_variant.default.hex_stripped}}FF;
    muted:      #{{colors.outline_variant.default.hex_stripped}}FF;

    accent:     #{{colors.primary.default.hex_stripped}}FF;
    accent2:    #{{colors.secondary.default.hex_stripped}}FF;
    green:      #{{colors.green.default.hex_stripped}}FF;
    yellow:     #{{colors.yellow.default.hex_stripped}}FF;
    orange:     #{{colors.orange.default.hex_stripped}}FF;
    red:        #{{colors.red.default.hex_stripped}}FF;
}
