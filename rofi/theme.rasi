@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @text;
}

window {
    transparency: "real";
    background-color: @base;
    border: 1px;
    border-color: @overlay;
    border-radius: 20px;
    width: 480px;
    padding: 24px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 14px;
}

inputbar {
    background-color: @surface0;
    border-radius: 999px;
    padding: 10px 20px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding: 0 8px 0 0;
}

entry {
    placeholder: "Search...";
    placeholder-color: @subtext;
    text-color: @text;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 6px;
    scrollbar: false;
    fixed-height: false;
}

scrollbar {
    width: 0px;
}

element {
    background-color: transparent;
    border-radius: 999px;
    padding: 8px 16px;
}

element selected {
    background-color: @accent;
    text-color: @base;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 20px;
    padding: 0 10px 0 0;
}
