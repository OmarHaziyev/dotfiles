/*
 * colors.rasi generated by matugen from the current wallpaper.
 * Mirrors ~/.config/theme/colors.css using the same name-to-role mapping,
 * with the alpha values the original static palette used baked back in
 * (rofi can't read GTK's alpha()/@define-color, so it needs literal RGBA
 * hex). Do not hand-edit edit this template instead.
 */

* {
    base:       #0e1415FF;
    mantle:     #090f0fFF;
    surface0:   #1a2121E6;
    surface1:   #252b2bE6;
    overlay:    #89939380;

    text:       #dde4e3FF;
    subtext:    #bec8c8FF;
    muted:      #3f4949FF;

    accent:     #80d4d7FF;
    accent2:    #b0ccccFF;
    green:      #9bd4a0FF;
    yellow:     #d8c76fFF;
    orange:     #ffb689FF;
    red:        #ffb0caFF;
}
